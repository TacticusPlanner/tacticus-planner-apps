# Mode marker for `vite build --mode production` (see package.json's build:production script).
# Vite loads this file for that mode, which is what gives `import.meta.env.MODE === "production"`
# at runtime (see shared/config/environment.ts). All real values (API base URL, MSAL config, ...)
# are injected as process env vars by the CD Prod workflow, which take precedence over anything
# here — this file intentionally carries no values of its own.
