{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": [
    "*.css",
    "./src/fsd/shared/config/i18n/i18n.ts"
  ],
  "scripts": {
    "dev": "vite",
    "dev:aspire": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "api:pull": "node scripts/api-spec.mjs pull",
    "api:types": "node scripts/api-spec.mjs",
    "datamine:pull": "node scripts/datamine.mjs pull",
    "datamine:sprites": "node scripts/datamine-sprites.mjs",
    "datamine:sync": "node scripts/datamine.mjs sync",
    "lint": "pnpm run lint:eslint && pnpm run lint:knip",
    "lint:eslint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:knip": "knip",
    "lint:compiler": "node scripts/react-compiler-skips.mjs",
    "lint:counts": "node --max-old-space-size=8192 scripts/lint-counts.mjs",
    "lint:fsd": "steiger ./src/fsd",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.29.1",
    "@azure/msal-react": "^5.8.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.107.2",
    "@workspace/game-catalog": "workspace:*",
    "@workspace/game-domain": "workspace:*",
    "@workspace/player-data": "workspace:*",
    "@workspace/ui": "workspace:*",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.0.10",
    "lucide-react": "catalog:",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.450.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^18.0.1",
    "react-joyride": "^3.2.0",
    "react-router": "^8.5.2",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "catalog:",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.1",
    "@posthog/rollup-plugin": "^1.6.4",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "^5.107.2",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/babel__core": "^7.20.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "^1.6.28",
    "axe-core": "^4.14.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "fake-indexeddb": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "openapi-typescript": "^7.13.0",
    "prettier": "catalog:",
