{
  "id": "tacticusplannerv2",
  "name": "Tacticus Planner",
  "short_name": "The Planner",
  "description": "Free fan-made planner for Tacticus: set goals for your roster and get a daily plan for raids, events and upgrades, synced from your game account.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "theme_color": "#EEF0F4",
  "background_color": "#EEF0F4",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Daily raids",
      "short_name": "Raids",
      "url": "/dailies/raids",
      "icons": [
        {
          "src": "/shortcuts/raids.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Goals",
      "url": "/plan/goals",
      "icons": [
        {
          "src": "/shortcuts/goals.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Legendary events",
      "short_name": "LE",
      "url": "/legendary-events",
      "icons": [
        {
          "src": "/shortcuts/legendary-events.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "categories": ["games", "utilities", "productivity"]
}
