{
  "name": "@workspace/game-catalog",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "lint": "pnpm run lint:eslint && pnpm run lint:knip",
    "lint:eslint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@workspace/game-domain": "workspace:*",
    "@workspace/manifest-sync": "workspace:*",
    "dexie": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./queries": "./src/queries.ts",
    "./testing": "./src/testing.ts",
    "./sync": "./src/sync.ts"
  }
}
