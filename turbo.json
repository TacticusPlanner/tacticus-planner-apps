{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_APP_VERSION",
        "VITE_MSAL_AUTHORITY",
        "VITE_MSAL_CLIENT_ID",
        "VITE_MSAL_TENANT_ID"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fsd": {
      "dependsOn": ["^lint:fsd"]
    },
    "knip": {
      "dependsOn": ["^build"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:run": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:aspire": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "VITE_API_BASE_URL",
        "VITE_API_SCOPE",
        "VITE_MSAL_AUTHORITY",
        "VITE_MSAL_CLIENT_ID",
        "VITE_MSAL_TENANT_ID"
      ]
    }
  }
}
